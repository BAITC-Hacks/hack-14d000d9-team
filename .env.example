# Never commit .env. Catalog credentials stay on server.
EKT_API_USER=
EKT_API_PASSWORD=
CATALOG_MODE=snapshot
# Store currency confirmed by the project owner; used when the API omits it.
EKT_CURRENCY=KZT
# Comma-separated store IDs confirmed by the business; empty means unknown availability.
EKT_SELLABLE_STORE_IDS=
# No model key: visibly labeled deterministic demo. auto enables AI only if key exists.
AGENT_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
COOKIE_SECURE=0
