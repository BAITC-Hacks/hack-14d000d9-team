# Phase 1 only. Default source is the checked-in supplied example, not live stock.
EKT_MODE=mock

# Supplied integration information; not independently live-verified.
# An origin only, without path, credentials, query, or trailing parameters.
EKT_BASE_URL=https://ekt.kz
# Detail requests append the supplied `id` query parameter.
EKT_PRODUCT_DETAIL_PATH=/api/products/detail

# Proposed prototype limits, NOT EKT operational limits.
EKT_TIMEOUT_SECONDS=10
MAX_UPSTREAM_RESPONSE_BYTES=2097152

# List/search, cart, sessions, confirmations, and analog settings are deliberately
# absent from Phase 1. CORS is disabled; no browser-origin allowlist is implemented.
